# ==========================================
# The Lenny Growth Assistant - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL / Supabase / Railway)
# If PostgreSQL is not configured or offline, the app automatically falls back to SQLite!
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
# Fallback example: sqlite+aiosqlite:///./data/lenny_assistant.db

# Local LLM (Ollama) - Mandatory for Offline / Local Demo
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=mistral:latest
FALLBACK_LOCAL_MODEL=qwen2.5:0.5b

# Cloud LLM Configuration (Optional - Enable by adding API keys)
ANTHROPIC_API_KEY=
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o

# Data Directories
TRANSCRIPTS_PATH=data/transcripts
INDEX_CACHE_PATH=data/index_cache

# Server Network Settings
HOST=0.0.0.0
PORT=8000
